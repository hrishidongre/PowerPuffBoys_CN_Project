# Team PowerPuffBoys - Section A - shared machine map.
# Fill this in ONCE per session, commit it, push it, everyone else pulls.
# Find your own IP with:  ./phase2/whoami.sh
#
# Role map:
#   Adi    - Mac 1 - primary DNS (dnsmasq)
#   Vetri  - Mac 2 - edge reverse proxy + load balancer (nginx, TLS)
#   Hrishi - Mac 3 - Backend A on 3001, plus standby edge for Extension E
#   Vedant - Mac 4 - Backend B on 3002
#
# Backup DNS moved to Vetri's Mac on 2026-11-23: Vedant's Mac is MDM managed by
# the college and its firewall blocks incoming DNS, which cannot be changed from
# the terminal. The brief only requires the backup to be off Mac 1.

DOMAIN=powerpuffboys.test
TTL=30

DNS_PRIMARY_IP=10.7.17.223
DNS_BACKUP_IP=10.7.17.226
EDGE_IP=10.7.17.226
EDGE_STANDBY_IP=10.7.8.234
BACKEND_A_IP=10.7.8.234
BACKEND_B_IP=10.7.2.238

# Ports. Switch to 8080/8443 if 80/443 will not bind.
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
BACKEND_A_PORT=3001
BACKEND_B_PORT=3002
